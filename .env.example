NODE_ENV=development # value is production in production

# turso Local development
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# better auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 #Base URL of your app

# github oauth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# minio S3 bucket for local development —— works with docker
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-west-1 # you can choose any region
S3_BUCKET= # bucket name
S3_BUCKET_URL=http://localhost:9000/images

# sentry
SENTRY_ORG=your-org-name
SENTRY_PROJECT=your-project-name
VITE_SENTRY_DSN=your-sentry-dsn

# better auth production
# BETTER_AUTH_URL= # production Base URL of your app

# turso production
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN= # stays the same for production unless you have different values

# aws s3 for production
# S3_REGION=us-west-1 # stays the same for production
# S3_BUCKET= bucket name 
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_URL=
# S3_ENDPOINT=